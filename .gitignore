# comparative methods: upstream checkouts stay local; the shared final-number
# targets and independent PyTorch integration code are tracked, while large
# run artifacts stay local.
/comparative_methods/*
!/comparative_methods/comparison_metric_targets_v1.yaml
!/comparative_methods/ASSET_STATUS.md
!/comparative_methods/audit_assets.py
!/comparative_methods/audit_public_preflight.py
