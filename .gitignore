!/comparative_methods/BrainFusion-NVC-CSP-Stacking/
!/comparative_methods/STA-Net-PyTorch/
!/comparative_methods/EFRM-PyTorch/

# Per-method local assets. Track only checkpoint documentation and empty run
# directories; cloned upstream repositories, model binaries, and generated
# outputs are reproducible from the source manifests and fetch scripts.
/comparative_methods/*/upstream/
/comparative_methods/*/checkpoints/*
!/comparative_methods/*/checkpoints/README.md
/comparative_methods/*/runs/*
!/comparative_methods/*/runs/.gitkeep
/comparative_methods/**/*.ckpt
/comparative_methods/**/*.pt
/comparative_methods/**/*.pth
/comparative_methods/**/*.safetensors

# Deterministic public/protected fold manifests are regenerated by
# build_split_registry.py; keep the generator, not thousands of JSON outputs.
/comparative_methods/STA-Net-PyTorch/split_registry/

